{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/subtitle-studio/**",
        "destination": "/subtitle-studio/index.html"
      },
      {
        "source": "/notify",
        "function": "payhereNotify"
      },
      {
        "source": "/proxyDownload",
        "function": "proxyDownload"
      },
      {
        "source": "/api/transcribeVideo",
        "function": "transcribeVideo"
      },
      {
        "source": "/api/generateMetadata",
        "function": "generateMetadata"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
