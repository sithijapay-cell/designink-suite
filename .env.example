# DesignInk Creative Suite Environment Variables

# Firebase Service Account Credentials (Required for Vercel to access Firestore key pool)
# Paste the entire single-line JSON string of your Firebase service account key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id",...}'

# Security Encryption Key for API key storage
ENCRYPTION_KEY="DesignInk_SafeKey_12345678901234"

# Optional Moondream2 ZeroGPU Microservice URL (HuggingFace ZeroGPU endpoint)
MOONDREAM_API_URL="https://vikhyat-moondream2.hf.space/generate"

# Local Development Port
PORT=3000
