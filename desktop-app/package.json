{
  "name": "designink-metadata-generator",
  "productName": "DesignInk Metadata Generator",
  "version": "1.0.0",
  "description": "DesignInk Next-Gen AI Metadata & Creative Automation Desktop Suite",
  "main": "main.js",
  "author": "DesignInk Studio",
  "scripts": {
    "sync": "node copy-assets.js",
    "start": "node copy-assets.js && electron .",
    "dist": "node copy-assets.js && electron-builder --win nsis"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google/generative-ai": "^0.24.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.6.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.designink.metadatagenerator",
    "productName": "DesignInk Metadata Generator",
    "files": [
      "main.js",
      "preload.js",
      "copy-assets.js",
      "public/**/*",
      "api/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DesignInk Metadata Generator"
    }
  }
}
